# Local Docker Compose configuration. Change secrets before public deployment.
POSTGRES_DB=crimelens_db
POSTGRES_USER=crimelens_user
POSTGRES_PASSWORD=crimelens_pass
POSTGRES_HOST_PORT=5433
JWT_SECRET=local_dev_only_change_this_secret_32chars_minimum
JWT_EXPIRATION_MS=86400000
ADMIN_PASSWORD=admin123
FRONTEND_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=crimelens_admin
ENABLE_TRANSFORMER=false
ENABLE_IMAGE_MODELS=false
INSTALL_MODELS=false
# Set MODEL_NAME to an actually trained eight-category checkpoint before enabling.
MODEL_NAME=
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
# Running backend outside Docker: export these values (Compose supplies its own).
DB_URL=jdbc:postgresql://localhost:5433/crimelens_db
DB_USERNAME=crimelens_user
DB_PASSWORD=crimelens_pass
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ELASTICSEARCH_URIS=http://localhost:9200
AI_SERVICE_URL=http://localhost:8000
